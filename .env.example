# ========================================================
# Brail Environment Configuration
# ========================================================

# 1. Deployment Wallet Private Key (For deploying to BOT Chain Bohr Testnet)
# Provide a dedicated testnet private key with BOT gas tokens on Bohr Testnet.
# Format: 0x followed by 64 hexadecimal characters
# WARNING: Never commit .env or use a private key associated with real mainnet assets.
DEPLOYER_PRIVATE_KEY=your_testnet_private_key_here

# 2. Deployed Vault Address (For frontend connection)
# Set after deployment:
VITE_VAULT_ADDRESS=
